[Unit]
Description=SD Day Traders booking API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sddt
Group=sddt
WorkingDirectory=/opt/sd-day-traders
EnvironmentFile=/etc/sddt-booking.env
EnvironmentFile=-/root/.3dvr/config/portal.env
ExecStart=/usr/bin/node server/start.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sddt
MemoryMax=128M

[Install]
WantedBy=multi-user.target
